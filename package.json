{
  "name": "@adasouls/alma-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:packages": "npm run test --workspaces --if-present",
    "build:packages": "npm run build --workspaces --if-present",
    "dev:identity-studio": "npm run dev --workspace apps/identity-studio",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:packages && changeset publish"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
